@model List<AcxiomCRM.ViewModels.Report.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-person-lines-fill text-dark me-2"></i>User Engagement & Activity Report</h2>
        <span class="text-muted small">Operational touches, logged calls, meetings, and completed tasks</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="UserActivity" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> All Reports
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Total Activities</th>
                        <th>Phone Calls</th>
                        <th>Customer Meetings</th>
                        <th>Emails Sent</th>
                        <th>Tasks Handled</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold">@u.UserName</td>
                            <td><span class="badge bg-primary fs-7">@u.TotalActivities</span></td>
                            <td>@u.Calls</td>
                            <td>@u.Meetings</td>
                            <td>@u.Emails</td>
                            <td>@u.Tasks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
