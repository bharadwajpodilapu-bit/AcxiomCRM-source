@model List<AcxiomCRM.ViewModels.Report.LeadReportItem>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-funnel text-warning me-2"></i>Lead Acquisition Report</h2>
        <span class="text-muted small">Status, sources, and prospect values</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Leads" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> All Reports
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th>Created Date</th>
                        <th>Conversion Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@l.LeadCode</td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                            <td><span class="badge bg-secondary">@l.Status</span></td>
                            <td>@l.Priority</td>
                            <td class="fw-bold">@(l.ExpectedValue?.ToString("C0") ?? "-")</td>
                            <td>@l.AssignedToName</td>
                            <td>@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>@(l.ConvertedCustomerName != null ? $"Converted: {l.ConvertedCustomerName}" : "Open")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
