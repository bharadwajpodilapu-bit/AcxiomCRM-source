@model List<AcxiomCRM.ViewModels.Report.FollowUpReportItem>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-calendar-event text-danger me-2"></i>Follow-Up Compliance Report</h2>
        <span class="text-muted small">Tracking outreach commitments and overdue touchpoints</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="FollowUps" asp-route-status="@ViewBag.Status" asp-route-overdueOnly="@ViewBag.OverdueOnly" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> All Reports
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Scheduled Date</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Related Entity</th>
                        <th>Overdue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@f.Subject</td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-secondary">@f.Status</span></td>
                            <td>@f.AssignedToName</td>
                            <td>@f.RelatedTo</td>
                            <td>
                                @if (f.IsOverdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">On Track</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
