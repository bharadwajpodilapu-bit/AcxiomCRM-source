@model AcxiomCRM.ViewModels.Report.PipelineReportViewModel
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Sales Pipeline Intelligence Report</h2>
        <span class="text-muted small">Stage valuations, sales executive commitments, and weighted probability forecasts</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> All Reports
        </a>
    </div>
</div>

<!-- Grand Totals Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 bg-primary text-white shadow-sm p-3">
            <span class="small opacity-75 text-uppercase fw-bold">Total Committed Pipeline</span>
            <span class="h2 fw-bold mb-0">@Model.GrandTotalAmount.ToString("C")</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 bg-success text-white shadow-sm p-3">
            <span class="small opacity-75 text-uppercase fw-bold">Probability-Weighted Forecast</span>
            <span class="h2 fw-bold mb-0">@Model.GrandWeightedAmount.ToString("C")</span>
        </div>
    </div>
</div>

<!-- Summaries Breakdown -->
<div class="row g-3 mb-4">
    <!-- Stage-wise -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-funnel me-2 text-info"></i>Stage-wise Breakdown</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Stage</th>
                            <th>Deals</th>
                            <th>Total Value</th>
                            <th>Weighted Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model.StageSummaries)
                        {
                            <tr>
                                <td class="fw-bold">@stage.Stage</td>
                                <td><span class="badge bg-light text-dark border">@stage.Count</span></td>
                                <td class="fw-bold">@stage.TotalAmount.ToString("C0")</td>
                                <td class="text-success fw-semibold">@stage.WeightedAmount.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner-wise -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Owner-wise Breakdown</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Owner</th>
                            <th>Deals</th>
                            <th>Total Value</th>
                            <th>Weighted Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var owner in Model.OwnerSummaries)
                        {
                            <tr>
                                <td class="fw-bold">@owner.OwnerName</td>
                                <td><span class="badge bg-light text-dark border">@owner.Count</span></td>
                                <td class="fw-bold">@owner.TotalAmount.ToString("C0")</td>
                                <td class="text-success fw-semibold">@owner.WeightedAmount.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detail Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <h6 class="fw-bold mb-0">Deals in Pipeline</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Deal Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opp in Model.Opportunities)
                    {
                        <tr>
                            <td class="fw-semibold">@opp.OpportunityName</td>
                            <td>@opp.CustomerName</td>
                            <td><span class="badge bg-info text-dark">@opp.Stage</span></td>
                            <td class="fw-bold">@opp.Amount.ToString("C0")</td>
                            <td>@opp.Probability%</td>
                            <td class="text-success fw-semibold">@opp.WeightedAmount.ToString("C0")</td>
                            <td>@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td>@opp.OwnerName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
