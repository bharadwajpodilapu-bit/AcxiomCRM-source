@model List<AcxiomCRM.ViewModels.Report.OpportunityReportItem>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-cash-stack text-info me-2"></i>Opportunities Forensic Report</h2>
        <span class="text-muted small">Comprehensive deal amounts, closing timelines, and probability distributions</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Opportunities" asp-route-stage="@ViewBag.Stage" asp-route-export="true" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> All Reports
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Deal Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Win Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Owner</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>@o.CustomerName</td>
                            <td><span class="badge bg-info text-dark">@o.Stage</span></td>
                            <td class="fw-bold">@o.Amount.ToString("C0")</td>
                            <td>@o.Probability%</td>
                            <td class="text-success fw-semibold">@o.WeightedAmount.ToString("C0")</td>
                            <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td>@o.OwnerName</td>
                            <td><span class="badge bg-secondary">@o.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
