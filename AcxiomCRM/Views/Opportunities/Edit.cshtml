@model AcxiomCRM.ViewModels.Opportunity.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.OpportunityName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-0 text-dark">Edit Opportunity: @Model.OpportunityName</h3>
                <span class="text-muted small">Update stage, amount, probability, or owner.</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold"></label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select"></select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label small fw-semibold">Deal Amount ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" id="oppAmount" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label small fw-semibold">Probability (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" min="0" max="100" id="oppProbability" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Weighted Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" id="weightedDisplay" class="form-control bg-light" readonly value="0.00" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label small fw-semibold"></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        @if (Model.OwnersList.Any())
                        {
                            <div class="col-md-12">
                                <label asp-for="OwnerId" class="form-label small fw-semibold">Opportunity Owner</label>
                                <select asp-for="OwnerId" asp-items="Model.OwnersList" class="form-select"></select>
                                <span asp-validation-for="OwnerId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label small fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcWeighted() {
            const amt = parseFloat(document.getElementById('oppAmount').value) || 0;
            const prob = parseFloat(document.getElementById('oppProbability').value) || 0;
            const weighted = (amt * prob) / 100;
            document.getElementById('weightedDisplay').value = weighted.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        document.getElementById('oppAmount').addEventListener('input', calcWeighted);
        document.getElementById('oppProbability').addEventListener('input', calcWeighted);
        calcWeighted();
    </script>
}
