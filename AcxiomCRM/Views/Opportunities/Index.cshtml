@model AcxiomCRM.ViewModels.Opportunity.OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-cash-stack text-info me-2"></i>Opportunities</h2>
        <span class="text-muted small">Manage deals, probability weighted pipeline, and closing forecasts</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" class="btn btn-outline-primary">
            <i class="bi bi-kanban me-1"></i> Pipeline View
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search opportunity, customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(Model.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                    <option value="Won" selected="@(Model.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.Status == "Lost")">Lost</option>
                </select>
            </div>
            @if (Model.OwnersList.Any())
            {
                <div class="col-md-3">
                    <select name="ownerId" asp-items="Model.OwnersList" class="form-select">
                        <option value="">All Owners</option>
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Stage</th>
                        <th>Expected Close</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Opportunities.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No opportunities found matching the criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Opportunities.Items)
                        {
                            var stageBadge = item.Stage switch {
                                "Qualification" => "bg-info text-dark",
                                "Proposal" => "bg-primary",
                                "Negotiation" => "bg-warning text-dark",
                                "Won" => "bg-success",
                                "Lost" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="fw-bold text-decoration-none text-dark">
                                        @item.OpportunityName
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">
                                        @(item.Customer?.CustomerName ?? "-")
                                    </a>
                                </td>
                                <td class="fw-bold text-dark">@item.Amount.ToString("C0")</td>
                                <td>@item.Probability%</td>
                                <td class="fw-semibold text-muted">@item.WeightedAmount.ToString("C0")</td>
                                <td><span class="badge @stageBadge">@item.Stage</span></td>
                                <td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td>@(item.Owner?.FullName ?? "-")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete opportunity @item.OpportunityName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Opportunities.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.Opportunities.PageIndex of @Model.Opportunities.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Opportunities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Opportunities.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.Opportunities.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Opportunities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Opportunities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Opportunities.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
