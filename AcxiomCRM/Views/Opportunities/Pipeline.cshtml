@model List<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
    var stages = new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-kanban text-primary me-2"></i>Pipeline Stage Board</h2>
        <span class="text-muted small">Visual stage distribution of deals and revenue probabilities</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i> List View
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
    </div>
</div>

<div class="row g-3 flex-nowrap overflow-auto pb-4">
    @foreach (var stage in stages)
    {
        var stageOpps = Model.Where(o => o.Stage == stage).ToList();
        var stageTotal = stageOpps.Sum(o => o.Amount);
        var headerBg = stage switch {
            "Qualification" => "bg-info text-dark",
            "Proposal" => "bg-primary text-white",
            "Negotiation" => "bg-warning text-dark",
            "Won" => "bg-success text-white",
            "Lost" => "bg-secondary text-white",
            _ => "bg-dark text-white"
        };

        <div class="col" style="min-width: 280px; max-width: 320px;">
            <div class="card border-0 bg-light shadow-sm h-100">
                <div class="card-header @headerBg py-2 rounded-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="small text-uppercase">@stage</strong>
                        <span class="badge bg-light text-dark">@stageOpps.Count</span>
                    </div>
                    <div class="small opacity-75 mt-1">@stageTotal.ToString("C0")</div>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-2" style="min-height: 500px; max-height: 70vh; overflow-y: auto;">
                    @if (!stageOpps.Any())
                    {
                        <div class="text-center text-muted small py-4">No deals in @stage</div>
                    }
                    else
                    {
                        foreach (var opp in stageOpps)
                        {
                            <div class="card border shadow-sm">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-1">
                                        <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none text-dark">
                                            @opp.OpportunityName
                                        </a>
                                    </h6>
                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-building me-1"></i> @(opp.Customer?.CustomerName ?? "No Customer")
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="fw-bold text-success">@opp.Amount.ToString("C0")</span>
                                        <span class="small badge bg-light text-dark border">@opp.Probability%</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                        <span><i class="bi bi-clock me-1"></i>@opp.ExpectedCloseDate.ToString("MMM dd")</span>
                                        <span class="text-truncate" style="max-width: 100px;">@(opp.Owner?.FullName ?? "")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
