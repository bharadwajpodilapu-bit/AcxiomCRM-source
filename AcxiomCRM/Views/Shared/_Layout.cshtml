@using AcxiomCRM.Authorization
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Top Navigation Bar -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-2 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-5 fw-bold text-white d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-diagram-3-fill text-primary me-2 fs-4"></i> AcxiomCRM
        </a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav flex-row ms-auto me-3 align-items-center">
            @if (SignInManager.IsSignedIn(User))
            {
                var role = User.IsInRole(AppRoles.Admin) ? AppRoles.Admin : (User.IsInRole(AppRoles.Manager) ? AppRoles.Manager : AppRoles.SalesExecutive);
                var roleBadgeClass = role switch {
                    AppRoles.Admin => "bg-danger",
                    AppRoles.Manager => "bg-warning text-dark",
                    _ => "bg-info text-dark"
                };

                <div class="nav-item text-nowrap me-3 text-light d-flex align-items-center">
                    <span class="me-2 d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                    </span>
                    <span class="badge @roleBadgeClass me-2">@role</span>
                </div>
                <div class="nav-item text-nowrap">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="nav-item text-nowrap me-2">
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                    </a>
                </div>
                <div class="nav-item text-nowrap">
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                        Register
                    </a>
                </div>
            }
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Sidebar Navigation -->
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse shadow-sm border-end py-3">
                    <div class="position-sticky pt-2 sidebar-sticky">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-building me-2 text-success"></i> Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leads" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-funnel me-2 text-warning"></i> Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Opportunities" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-cash-stack me-2 text-info"></i> Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "FollowUps" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-event me-2 text-danger"></i> Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Activities" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-clock-history me-2 text-secondary"></i> Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-file-earmark-bar-graph me-2 text-purple"></i> Reports
                                </a>
                            </li>
                        </ul>

                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase fs-7 fw-bold">
                                <span>Administration</span>
                            </h6>
                            <ul class="nav flex-column mb-2">
                                <li class="nav-item">
                                    <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people-fill me-2 text-primary"></i> User Management
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark py-2 px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "active bg-light fw-bold text-primary rounded" : "")" asp-controller="AuditLogs" asp-action="Index">
                                        <i class="bi bi-shield-check me-2 text-danger"></i> Audit Logs
                                    </a>
                                </li>
                            </ul>
                        }

                        <hr class="my-3 text-muted">
                        <div class="px-3 small text-muted">
                            <span class="d-block"><i class="bi bi-shield-lock me-1"></i> Role: @(User.IsInRole(AppRoles.Admin) ? "Administrator" : (User.IsInRole(AppRoles.Manager) ? "Sales Manager" : "Sales Executive"))</span>
                            <span class="d-block mt-1">UTC: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                </nav>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 min-vh-100">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12 py-5 min-vh-100">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <!-- Reusable Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationModalLabel">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmationModalBody">
                    Are you sure you want to proceed with this action?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmationModalConfirmBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
