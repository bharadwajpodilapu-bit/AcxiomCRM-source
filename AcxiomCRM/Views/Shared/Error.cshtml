@{
    ViewData["Title"] = "Error";
    var traceId = Context.Request.Query["traceId"].ToString();
    if (string.IsNullOrEmpty(traceId)) traceId = Context.TraceIdentifier;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <div class="text-danger mb-3">
                        <i class="bi bi-exclamation-octagon-fill fs-1"></i>
                    </div>
                    <h2 class="h4 fw-bold text-dark">An Unexpected Error Occurred</h2>
                    <p class="text-muted">
                        We apologize for the inconvenience. An unexpected error occurred while processing your request.
                        The incident has been recorded in the system logs.
                    </p>
                    <div class="alert alert-secondary text-monospace small py-2 mb-4">
                        <strong>Correlation / Trace ID:</strong> <code>@traceId</code>
                    </div>
                    <div>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">
                            <i class="bi bi-house-door me-1"></i> Return to Dashboard
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
