@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = $"Follow-Up: {Model.Subject}";
    var statusBadge = Model.Status switch {
        "Completed" => "bg-success",
        "Planned" => Model.IsOverdue ? "bg-danger" : "bg-warning text-dark",
        "Missed" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold text-dark mb-0">@Model.Subject</h2>
            <span class="badge @statusBadge">@Model.Status</span>
            @if (Model.IsOverdue)
            {
                <span class="badge bg-danger">Overdue</span>
            }
        </div>
        <span class="text-muted small">Type: <strong>@Model.FollowUpType</strong> &bull; Assigned: @(Model.AssignedUser?.FullName ?? "Unassigned")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<!-- Action Workflow Controls -->
@if (Model.Status == "Planned")
{
    <div class="card border-0 bg-white shadow-sm mb-4">
        <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <strong class="text-secondary small text-uppercase">Follow-Up Workflow Actions:</strong>
                <span class="text-muted small ms-2">Mark outcome or reschedule if postponed:</span>
            </div>
            <div class="d-flex gap-2">
                <form asp-action="ChangeStatus" asp-route-id="@Model.FollowUpId" asp-route-newStatus="Completed" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-check-lg me-1"></i> Mark Completed
                    </button>
                </form>
                <form asp-action="ChangeStatus" asp-route-id="@Model.FollowUpId" asp-route-newStatus="Missed" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm text-dark">
                        <i class="bi bi-exclamation-triangle me-1"></i> Mark Missed
                    </button>
                </form>
                <form asp-action="ChangeStatus" asp-route-id="@Model.FollowUpId" asp-route-newStatus="Cancelled" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>
                </form>
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#rescheduleCard">
                    <i class="bi bi-clock-history me-1"></i> Reschedule...
                </button>
            </div>
        </div>
    </div>

    <!-- Inline Reschedule Box -->
    <div class="collapse mb-4" id="rescheduleCard">
        <div class="card border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-2">Reschedule Follow-Up</h6>
                <form asp-action="Reschedule" asp-route-id="@Model.FollowUpId" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">New Date & Time</label>
                        <input type="datetime-local" name="newDate" class="form-control form-control-sm" required min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Reason / Remarks</label>
                        <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Client requested delay to next Tuesday" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Save Date</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0 text-muted text-uppercase small">Follow-Up Schedule Details</h6>
            </div>
            <div class="card-body pt-0 small">
                <div class="mb-2"><strong>Scheduled Date:</strong> @Model.FollowUpDate.ToString("yyyy-MM-dd HH:mm") UTC</div>
                <div class="mb-2"><strong>Type:</strong> @Model.FollowUpType</div>
                <div class="mb-2"><strong>Status:</strong> @Model.Status</div>
                <div class="mb-2"><strong>Assigned To:</strong> @(Model.AssignedUser?.FullName ?? "Unassigned")</div>
                <div class="mb-2"><strong>Created By:</strong> @Model.CreatedBy</div>
                <div class="mb-0"><strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC</div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="mt-2 text-muted">Last modified: @Model.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm") UTC</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0 text-muted text-uppercase small">Context & Association</h6>
            </div>
            <div class="card-body pt-0 small">
                @if (Model.Customer != null)
                {
                    <div class="mb-3">
                        <span class="text-muted d-block">Related Customer:</span>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                            <i class="bi bi-building me-1"></i> @Model.Customer.CustomerName
                        </a>
                    </div>
                }
                @if (Model.Lead != null)
                {
                    <div class="mb-3">
                        <span class="text-muted d-block">Related Lead:</span>
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-decoration-none">
                            <i class="bi bi-funnel me-1"></i> @Model.Lead.LeadName
                        </a>
                    </div>
                }
                @if (Model.Opportunity != null)
                {
                    <div class="mb-3">
                        <span class="text-muted d-block">Related Opportunity:</span>
                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId" class="fw-bold text-decoration-none">
                            <i class="bi bi-cash-stack me-1"></i> @Model.Opportunity.OpportunityName
                        </a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <hr class="my-2">
                    <div>
                        <strong>Remarks & Activity History:</strong>
                        <p class="text-secondary mt-1 mb-0">@Model.Remarks</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
