@model AcxiomCRM.ViewModels.FollowUp.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-calendar-event text-danger me-2"></i>Follow-Ups</h2>
        <span class="text-muted small">Schedule calls, meetings, reminders, and customer touchpoints</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-danger">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search subject, remarks..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.Type == "Email")">Email</option>
                    <option value="Task" selected="@(Model.Type == "Task")">Task</option>
                    <option value="Other" selected="@(Model.Type == "Other")">Other</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check pt-2">
                    <input class="form-check-input" type="checkbox" name="overdueOnly" value="true" id="overdueCheck" @(Model.OverdueOnly == true ? "checked" : "") />
                    <label class="form-check-label small fw-bold text-danger" for="overdueCheck">
                        Overdue Only
                    </label>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Scheduled Date & Time</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Related Entity</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.FollowUps.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                                No follow-up activities found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.FollowUps.Items)
                        {
                            var statusBadge = item.Status switch {
                                "Completed" => "bg-success",
                                "Planned" => item.IsOverdue ? "bg-danger" : "bg-warning text-dark",
                                "Missed" => "bg-danger",
                                "Cancelled" => "bg-secondary",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.FollowUpId" class="fw-bold text-decoration-none text-dark">
                                        @item.Subject
                                    </a>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.FollowUpType</span></td>
                                <td>@item.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @statusBadge">@item.Status</span></td>
                                <td>@(item.AssignedUser?.FullName ?? "-")</td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <span>Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">@item.Customer.CustomerName</a></span>
                                    }
                                    else if (item.Lead != null)
                                    {
                                        <span>Lead: <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">@item.Lead.LeadName</a></span>
                                    }
                                    else if (item.Opportunity != null)
                                    {
                                        <span>Opportunity: <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">@item.Opportunity.OpportunityName</a></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == "Planned")
                                        {
                                            <form asp-action="ChangeStatus" asp-route-id="@item.FollowUpId" asp-route-newStatus="Completed" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form asp-action="ChangeStatus" asp-route-id="@item.FollowUpId" asp-route-newStatus="Missed" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Mark Missed">
                                                    <i class="bi bi-exclamation"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.FollowUpId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete follow-up @item.Subject?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.FollowUps.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.FollowUps.PageIndex of @Model.FollowUps.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.FollowUps.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.FollowUps.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-overdueOnly="@Model.OverdueOnly">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.FollowUps.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.FollowUps.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-overdueOnly="@Model.OverdueOnly">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.FollowUps.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.FollowUps.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-overdueOnly="@Model.OverdueOnly">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
