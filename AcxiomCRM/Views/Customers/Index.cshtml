@model AcxiomCRM.ViewModels.Customer.CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-building text-success me-2"></i>Customers</h2>
        <span class="text-muted small">Manage accounts, contacts, and relationship records</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Customer
        </a>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email, phone, company..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            @if (Model.OwnersList.Any())
            {
                <div class="col-md-3">
                    <select name="ownerId" asp-items="Model.OwnersList" class="form-select">
                        <option value="">All Owners</option>
                    </select>
                </div>
            }
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Contact</th>
                        <th>Company</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Customers.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No customers found matching the search criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Customers.Items)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@item.CustomerCode</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="fw-bold text-decoration-none text-dark">
                                        @item.CustomerName
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.City))
                                    {
                                        <span class="text-muted d-block small">@item.City, @item.State</span>
                                    }
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                    <div><i class="bi bi-telephone me-1 text-muted"></i>@item.Phone</div>
                                </td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>@(item.Owner?.FullName ?? "-")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (item.Status == "Active")
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate customer @item.CustomerName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Deactivate">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete or deactivate @item.CustomerName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Customers.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">
                Showing page @Model.Customers.PageIndex of @Model.Customers.TotalPages (@Model.Customers.TotalCount total records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Customers.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Customers.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownerId="@Model.OwnerId">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.Customers.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Customers.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownerId="@Model.OwnerId">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Customers.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Customers.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownerId="@Model.OwnerId">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
