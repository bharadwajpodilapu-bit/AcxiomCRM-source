@model AcxiomCRM.ViewModels.Customer.CustomerDetailsViewModel
@{
    ViewData["Title"] = Model.Customer.CustomerName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold text-dark mb-0">@Model.Customer.CustomerName</h2>
            <span class="badge @(Model.Customer.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Customer.Status</span>
        </div>
        <span class="text-muted small">Customer Code: <strong>@Model.Customer.CustomerCode</strong> &bull; Managed by: @(Model.Customer.Owner?.FullName ?? "Unassigned")</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Customer
            </a>
        }
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-cash-stack me-1"></i> Add Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-danger btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-secondary btn-sm">
            <i class="bi bi-chat-dots me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Customer Card Profile -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0 text-muted text-uppercase small">Contact & Info</h6>
            </div>
            <div class="card-body pt-0 small">
                <div class="mb-2"><strong>Email:</strong> <a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></div>
                <div class="mb-2"><strong>Phone:</strong> @Model.Customer.Phone</div>
                <div class="mb-2"><strong>Company:</strong> @(Model.Customer.CompanyName ?? "-")</div>
                <div class="mb-2"><strong>Address:</strong> @(Model.Customer.Address ?? "-")</div>
                <div class="mb-2"><strong>City / State:</strong> @(string.IsNullOrEmpty(Model.Customer.City) ? "-" : $"{Model.Customer.City}, {Model.Customer.State}")</div>
                <div class="mb-2"><strong>Created Date:</strong> @Model.Customer.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC</div>
                <div class="mb-0"><strong>Created By:</strong> @Model.Customer.CreatedBy</div>
            </div>
        </div>
    </div>

    <!-- Related Opportunities -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-cash-stack text-primary me-2"></i>Opportunities (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">+ New</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Opportunity</th>
                                <th>Amount</th>
                                <th>Probability</th>
                                <th>Weighted</th>
                                <th>Stage</th>
                                <th>Expected Close</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Opportunities.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted">No opportunities logged for this customer.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var o in Model.Opportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-bold text-decoration-none">
                                                @o.OpportunityName
                                            </a>
                                        </td>
                                        <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                        <td>@o.Probability%</td>
                                        <td class="text-muted">@o.WeightedAmount.ToString("C0")</td>
                                        <td><span class="badge bg-info text-dark">@o.Stage</span></td>
                                        <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Related Follow-Ups and Activities -->
<div class="row g-3 mb-4">
    <!-- Follow-Ups -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event text-danger me-2"></i>Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-danger">+ Schedule</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FollowUps.Any())
                            {
                                <tr><td colspan="4" class="text-center py-3 text-muted">No follow-ups recorded.</td></tr>
                            }
                            else
                            {
                                foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="text-decoration-none fw-semibold">
                                                @f.Subject
                                            </a>
                                            @if (f.IsOverdue)
                                            {
                                                <span class="badge bg-danger ms-1">Overdue</span>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                        <td>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-warning text-dark"))">@f.Status</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Activities -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-chat-dots text-secondary me-2"></i>Activities (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-secondary">+ Log</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Activities.Any())
                            {
                                <tr><td colspan="4" class="text-center py-3 text-muted">No activities logged yet.</td></tr>
                            }
                            else
                            {
                                foreach (var a in Model.Activities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Activities" asp-action="Details" asp-route-id="@a.ActivityId" class="text-decoration-none fw-semibold">
                                                @a.Subject
                                            </a>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@a.ActivityType</span></td>
                                        <td>@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-success">@a.Status</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
