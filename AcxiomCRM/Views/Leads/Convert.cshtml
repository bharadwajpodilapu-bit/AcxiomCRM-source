@model AcxiomCRM.ViewModels.Lead.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead: {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-0 text-success"><i class="bi bi-arrow-repeat me-2"></i>Convert Lead to Customer</h3>
                <span class="text-muted small">Promote qualified lead into an active customer account with optional deal opportunity.</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                Cancel
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="alert alert-light border p-3 rounded mb-4">
                        <h6 class="fw-bold text-dark mb-2">Customer Account to Create:</h6>
                        <ul class="mb-0 small text-secondary">
                            <li><strong>Name:</strong> @Model.LeadName</li>
                            <li><strong>Company:</strong> @(Model.CompanyName ?? "N/A")</li>
                            <li><strong>Email:</strong> @(Model.Email ?? "N/A")</li>
                            <li><strong>Phone:</strong> @(Model.Phone ?? "N/A")</li>
                        </ul>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" id="createOppSwitch" />
                        <label asp-for="CreateOpportunity" class="form-check-label fw-bold small text-dark"></label>
                    </div>

                    <div id="opportunityFields">
                        <div class="row g-3 p-3 bg-light rounded border mb-3">
                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label small fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OpportunityAmount" class="form-control" placeholder="10000" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold"></label>
                                <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Convert & Finalize
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const oppSwitch = document.getElementById('createOppSwitch');
        const oppFields = document.getElementById('opportunityFields');

        function toggleOppFields() {
            oppFields.style.display = oppSwitch.checked ? 'block' : 'none';
        }

        oppSwitch.addEventListener('change', toggleOppFields);
        toggleOppFields();
    </script>
}
