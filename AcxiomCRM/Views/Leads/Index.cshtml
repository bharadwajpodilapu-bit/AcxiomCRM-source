@model AcxiomCRM.ViewModels.Lead.LeadListViewModel
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-funnel text-warning me-2"></i>Leads</h2>
        <span class="text-muted small">Track prospect inquiries, qualification, and sales conversions</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-warning text-dark fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> New Lead
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name, company, email..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.Status == "New")">New</option>
                    <option value="Contacted" selected="@(Model.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.Status == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.Status == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="priority" class="form-select">
                    <option value="">All Priorities</option>
                    <option value="High" selected="@(Model.Priority == "High")">High</option>
                    <option value="Medium" selected="@(Model.Priority == "Medium")">Medium</option>
                    <option value="Low" selected="@(Model.Priority == "Low")">Low</option>
                </select>
            </div>
            @if (Model.UsersList.Any())
            {
                <div class="col-md-3">
                    <select name="assignedTo" asp-items="Model.UsersList" class="form-select">
                        <option value="">All Assigned</option>
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Leads.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No leads found matching criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Leads.Items)
                        {
                            var statusBadge = item.Status switch {
                                "New" => "bg-primary",
                                "Contacted" => "bg-info text-dark",
                                "Qualified" => "bg-warning text-dark",
                                "Converted" => "bg-success",
                                "Lost" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            var priorityBadge = item.Priority switch {
                                "High" => "badge text-bg-danger",
                                "Medium" => "badge text-bg-warning",
                                _ => "badge text-bg-secondary"
                            };

                            <tr>
                                <td class="fw-bold text-muted">@item.LeadCode</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-decoration-none text-dark">
                                        @item.LeadName
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <span class="text-muted d-block small">@item.Email</span>
                                    }
                                </td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td><span class="badge @statusBadge">@item.Status</span></td>
                                <td><span class="@priorityBadge">@item.Priority</span></td>
                                <td class="fw-bold">@(item.ExpectedValue?.ToString("C0") ?? "-")</td>
                                <td>@(item.AssignedUser?.FullName ?? "-")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Status != "Converted" && item.Status != "Lost")
                                        {
                                            <a asp-action="Convert" asp-route-id="@item.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-check-circle"></i> Convert
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        <form asp-action="Delete" asp-route-id="@item.LeadId" method="post" class="d-inline" onsubmit="return confirm('Delete lead @item.LeadName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Leads.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.Leads.PageIndex of @Model.Leads.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Leads.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Leads.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.Leads.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Leads.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Leads.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Leads.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
