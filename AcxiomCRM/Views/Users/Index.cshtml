@model List<AcxiomCRM.ViewModels.User.UserListViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-people-fill text-primary me-2"></i>User & Role Management</h2>
        <span class="text-muted small">Admin controls: Manage operator identities, assign roles, and handle account lockouts</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> New User
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Full Name</th>
                        <th>Email / Username</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Lockout</th>
                        <th>Created Date</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var user in Model)
                    {
                        var roleBadge = user.Role switch {
                            "Admin" => "bg-danger",
                            "Manager" => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        <tr>
                            <td class="fw-bold">@user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge @roleBadge">@user.Role</span></td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Disabled</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Normal</span>
                                }
                            </td>
                            <td>@user.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>@(user.LastLoginDate.HasValue ? user.LastLoginDate.Value.ToString("yyyy-MM-dd HH:mm") : "Never")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    <form asp-action="ToggleLockout" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsLockedOut ? "btn-outline-success" : "btn-outline-warning")" title="@(user.IsLockedOut ? "Unlock Account" : "Lock Account")">
                                            <i class="bi @(user.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle active status for @user.FullName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
