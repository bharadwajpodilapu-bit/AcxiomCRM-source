@model AcxiomCRM.ViewModels.Audit.AuditLogListViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-shield-check text-danger me-2"></i>Audit Logs</h2>
        <span class="text-muted small">Immutable append-only system & operational audit trail</span>
    </div>
</div>

<!-- Audit Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            @if (Model.UsersList.Any())
            {
                <div class="col-md-2">
                    <select name="userId" asp-items="Model.UsersList" class="form-select form-select-sm">
                        <option value="">All Users</option>
                    </select>
                </div>
            }
            <div class="col-md-2">
                <input type="text" name="module" value="@Model.Module" class="form-control form-control-sm" placeholder="Module (e.g. Auth, Customer)" />
            </div>
            <div class="col-md-2">
                <input type="text" name="actionName" value="@Model.Action" class="form-control form-control-sm" placeholder="Action (Create, Update...)" />
            </div>
            <div class="col-md-2">
                <select name="result" class="form-select form-select-sm">
                    <option value="">All Results</option>
                    <option value="Success" selected="@(Model.Result == "Success")">Success</option>
                    <option value="Failed" selected="@(Model.Result == "Failed")">Failed</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" title="From Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace small" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Entity / ID</th>
                        <th>Result</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Logs.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted font-sans-serif">
                                <i class="bi bi-journal-x fs-3 d-block mb-1"></i>
                                No audit log records matching the filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.Logs.Items)
                        {
                            <tr>
                                <td>@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(log.User?.FullName ?? (log.UserId ?? "System"))</td>
                                <td><span class="badge bg-light text-dark border">@log.Module</span></td>
                                <td class="fw-bold">@log.Action</td>
                                <td>@log.EntityName @(!string.IsNullOrEmpty(log.RecordId) ? $"#{log.RecordId}" : "")</td>
                                <td>
                                    <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger")">@log.Result</span>
                                </td>
                                <td class="text-truncate" style="max-width: 250px;" title="@log.Details">
                                    @(log.Details ?? "-")
                                </td>
                                <td>@(log.IpAddress ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Logs.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.Logs.PageIndex of @Model.Logs.TotalPages (@Model.Logs.TotalCount records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Logs.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Logs.PageIndex - 1)" asp-route-module="@Model.Module" asp-route-actionName="@Model.Action" asp-route-result="@Model.Result">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.Logs.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Logs.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-module="@Model.Module" asp-route-actionName="@Model.Action" asp-route-result="@Model.Result">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Logs.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Logs.PageIndex + 1)" asp-route-module="@Model.Module" asp-route-actionName="@Model.Action" asp-route-result="@Model.Result">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
