@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger border-2 p-4">
                <div class="card-body">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-slash-fill fs-1"></i>
                    </div>
                    <h2 class="h4 fw-bold text-danger">Access Denied</h2>
                    <p class="text-muted">
                        You do not have the required permissions or role to access this CRM resource.
                        Resource-level authorization rules prevent unauthorized modifications or viewing.
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">
                            <i class="bi bi-house-door me-1"></i> Go to Dashboard
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
