@model AcxiomCRM.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-3 border-bottom">
    <div>
        <h1 class="h3 fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard
        </h1>
        <p class="text-muted small mb-0">Role Scope: <span class="badge bg-secondary">@Model.Role</span> &bull; Real-time CRM operational performance</p>
    </div>

    <!-- Period Filters -->
    <div class="btn-toolbar mb-2 mb-md-0">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Index" asp-route-period="Today" class="btn @(Model.FilterPeriod == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
                <a asp-action="Index" asp-route-period="ThisWeek" class="btn @(Model.FilterPeriod == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
                <a asp-action="Index" asp-route-period="ThisMonth" class="btn @(Model.FilterPeriod == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
            </div>
        </form>
    </div>
</div>

<!-- Admin Security Summary Row (Admin Only) -->
@if (Model.Role == "Admin")
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 bg-primary bg-opacity-10 shadow-sm">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-lock-fill text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">System & Security Overview</h6>
                            <span class="small text-muted">Administrative control metrics</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-4 text-center">
                        <div>
                            <div class="fs-5 fw-bold text-dark">@Model.TotalUsers</div>
                            <span class="small text-muted">Total Users</span>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-success">@Model.ActiveUsers</div>
                            <span class="small text-muted">Active Users</span>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-danger">@Model.LockedUsers</div>
                            <span class="small text-muted">Locked Accounts</span>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-info">@Model.SecurityEventsCount</div>
                            <span class="small text-muted">Auth Audit Events</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Primary CRM Metrics Row -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100 border-start border-primary border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Total Customers</div>
                        <div class="h3 fw-bold mb-0 text-dark">@Model.TotalCustomers</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small">
                    <a asp-controller="Customers" asp-action="Index" class="text-decoration-none text-primary">View Customers &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Total / Open Leads -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Open Leads / Total</div>
                        <div class="h3 fw-bold mb-0 text-dark">@Model.OpenLeads <span class="fs-6 fw-normal text-muted">/ @Model.TotalLeads</span></div>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-funnel-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small">
                    <a asp-controller="Leads" asp-action="Index" class="text-decoration-none text-warning">View Leads Pipeline &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Value -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Active Pipeline Value</div>
                        <div class="h3 fw-bold mb-0 text-success">@Model.TotalPipelineValue.ToString("C0")</div>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    Weighted: <span class="fw-bold text-dark">@Model.WeightedPipelineValue.ToString("C0")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Follow-Ups -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100 border-start @(Model.OverdueFollowUps > 0 ? "border-danger" : "border-info") border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Pending Follow-Ups</div>
                        <div class="h3 fw-bold mb-0 text-dark">
                            @Model.PendingFollowUps
                            @if (Model.OverdueFollowUps > 0)
                            {
                                <span class="badge bg-danger fs-7 ms-1">@Model.OverdueFollowUps Overdue</span>
                            }
                        </div>
                    </div>
                    <div class="@(Model.OverdueFollowUps > 0 ? "bg-danger" : "bg-info") bg-opacity-10 p-3 rounded-circle text-@(Model.OverdueFollowUps > 0 ? "danger" : "info")">
                        <i class="bi bi-calendar-event fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 small">
                    <a asp-controller="FollowUps" asp-action="Index" class="text-decoration-none text-info">View Schedule &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Opportunity Breakdown Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-bold text-uppercase">Open Opportunities</span>
            <span class="fs-4 fw-bold text-primary">@Model.OpenOpportunities</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-bold text-uppercase">Won Deals</span>
            <span class="fs-4 fw-bold text-success">@Model.WonOpportunities</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-bold text-uppercase">Lost Deals</span>
            <span class="fs-4 fw-bold text-secondary">@Model.LostOpportunities</span>
        </div>
    </div>
</div>

<!-- Chart.js Visualizations Row -->
<div class="row g-3 mb-4">
    <!-- Lead Status Doughnut Chart -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-warning me-2"></i>Leads by Status</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Pipeline Funnel / Bar Chart -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-info me-2"></i>Opportunity Pipeline Value ($)</h6>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Sales Trend Chart -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>6-Month Sales Trend</h6>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Follow-ups and Top Opportunities Tables -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-check text-danger me-2"></i>Upcoming Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Related To</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.UpcomingFollowUps.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No upcoming follow-ups scheduled.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var f in Model.UpcomingFollowUps)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="fw-semibold text-decoration-none">
                                                @f.Subject
                                            </a>
                                            @if (f.IsOverdue)
                                            {
                                                <span class="badge bg-danger ms-1">Overdue</span>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                        <td>@f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@f.RelatedTo</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-trophy text-primary me-2"></i>Top Open Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Opportunity</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Stage</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.TopOpportunities.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No open opportunities found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var o in Model.TopOpportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none">
                                                @o.OpportunityName
                                            </a>
                                        </td>
                                        <td>@o.CustomerName</td>
                                        <td class="fw-bold text-success">@o.Amount.ToString("C0")</td>
                                        <td><span class="badge bg-info text-dark">@o.Stage</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lead Status Chart
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                    backgroundColor: ['#0d6efd', '#17a2b8', '#ffc107', '#6c757d', '#dc3545', '#198754']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12 } }
                }
            }
        });

        // 2. Opportunity Pipeline Chart
        const oppCtx = document.getElementById('pipelineChart').getContext('2d');
        new Chart(oppCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageLabels)),
                datasets: [{
                    label: 'Stage Value ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageAmounts)),
                    backgroundColor: ['#0dcaf0', '#0d6efd', '#fd7e14', '#198754', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        // 3. Monthly Sales Chart
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
                datasets: [
                    {
                        label: 'Won Revenue ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWonAmounts)),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        fill: true,
                        tension: 0.3
                    },
                    {
                        label: 'Created Pipeline ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyPipelineAmounts)),
                        borderColor: '#0d6efd',
                        backgroundColor: 'transparent',
                        borderDash: [5, 5],
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12 } }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
