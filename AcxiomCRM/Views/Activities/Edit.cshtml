@model AcxiomCRM.ViewModels.Activity.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-0 text-dark">Edit Activity: @Model.Subject</h3>
                <span class="text-muted small">Update activity log details.</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.ActivityId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.ActivityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ActivityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Subject" class="form-label small fw-semibold">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ActivityType" class="form-label small fw-semibold"></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ActivityDate" class="form-label small fw-semibold">Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="p-3 bg-light rounded border">
                                <span class="fw-bold small text-dark d-block mb-2">Relate to CRM Record:</span>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label asp-for="CustomerId" class="form-label small fw-semibold"></label>
                                        <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="LeadId" class="form-label small fw-semibold"></label>
                                        <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="OpportunityId" class="form-label small fw-semibold"></label>
                                        <select asp-for="OpportunityId" asp-items="Model.OpportunitiesList" class="form-select"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.UsersList.Any())
                        {
                            <div class="col-md-12">
                                <label asp-for="AssignedTo" class="form-label small fw-semibold"></label>
                                <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select"></select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label small fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
