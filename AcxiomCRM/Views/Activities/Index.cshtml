@model AcxiomCRM.ViewModels.Activity.ActivityListViewModel
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold text-dark mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Activities</h2>
        <span class="text-muted small">Log customer touches, phone calls, meetings, emails, and tasks</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-secondary">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search subject, description..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.Type == "Email")">Email</option>
                    <option value="Task" selected="@(Model.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            @if (Model.UsersList.Any())
            {
                <div class="col-md-2">
                    <select name="assignedTo" asp-items="Model.UsersList" class="form-select">
                        <option value="">All Users</option>
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-filter"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Date & Time</th>
                        <th>User</th>
                        <th>Associated Record</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Activities.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No activities recorded matching filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Activities.Items)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.ActivityId" class="fw-bold text-decoration-none text-dark">
                                        @item.Subject
                                    </a>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.ActivityType</span></td>
                                <td>@item.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(item.AssignedUser?.FullName ?? "-")</td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <span>Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId">@item.Customer.CustomerName</a></span>
                                    }
                                    else if (item.Lead != null)
                                    {
                                        <span>Lead: <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId">@item.Lead.LeadName</a></span>
                                    }
                                    else if (item.Opportunity != null)
                                    {
                                        <span>Opp: <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId">@item.Opportunity.OpportunityName</a></span>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td><span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@item.Status</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.ActivityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete activity @item.Subject?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Activities.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.Activities.PageIndex of @Model.Activities.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Activities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Activities.PageIndex - 1)" asp-route-search="@Model.Search">&laquo; Prev</a>
                </li>
                @for (int p = 1; p <= Model.Activities.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Activities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Activities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Activities.PageIndex + 1)" asp-route-search="@Model.Search">Next &raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
